{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private grounded document QA row",
  "type": "object",
  "required": ["id", "images", "messages", "question", "answer", "answer_bbox"],
  "properties": {
    "id": {"type": "string"},
    "images": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
    "messages": {
      "type": "array",
      "prefixItems": [
        {"type": "object", "required": ["role", "content"]},
        {"type": "object", "required": ["role", "content"]}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "answer_bbox": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 1000},
      "minItems": 4,
      "maxItems": 4
    },
    "ocr_cache": {"type": "string"}
  }
}
