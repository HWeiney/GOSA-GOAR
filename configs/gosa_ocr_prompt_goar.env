EXPERIMENT=internvl35_gosa_ocr_prompt_goar
OCR_MODE=prompt
USE_OCR=True
ENABLE_LOCAL_PE=True
ENABLE_GLOBAL_PE=True
ENABLE_GOAR=True
GOAR_INFERENCE_BOX_MODE=fusion
GOAR_USE_ROI_FEATURE=True
GOAR_SPATIAL_INJECTION=True
GOAR_OCR_EVIDENCE_INJECTION=True
GOAR_RECORD_INJECTION_STATS=False
GOAR_BOTTLENECK=256
GOAR_MAX_OCR_LINES=128
GOAR_POINTER_LOSS_WEIGHT=0.2
GOAR_BRANCH_LOSS_WEIGHT=0.25
GOAR_UNCERTAINTY_LOSS_WEIGHT=0.1
GOAR_LOSS_WEIGHT=1.0
TRAIN_STRATEGY=lora
SEED=${SEED:-123}
DATA_SEED=${DATA_SEED:-${SEED}}
